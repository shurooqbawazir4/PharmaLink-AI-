# --- Environments / secrets --------------------------------------------
.env
docker/.env
*.env.local

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / Next.js ----------------------------------------------------------
node_modules/
.next/
out/
frontend/.env*.local

# --- ML artifacts ------------------------------------------------------------
ml/**/*.ckpt
ml/**/*.pt
ml/**/artifacts/

# --- Data (generated CSV output isn't committed; the scripts that make it
# are — data/synthetic/ holds both generate.py *and* its own CSV output, so
# this ignores by extension there rather than blanket-excluding the dir) ---
data/raw/*
data/processed/*
data/synthetic/*.csv
!data/**/.gitkeep

# --- Editors / OS -------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
