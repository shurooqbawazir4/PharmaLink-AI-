# syntax=docker/dockerfile:1
# Built with repo root as build context (see docker-compose.yml) so it can
# later also COPY the /ml package once the backend depends on it directly.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps needed to build asyncpg / psycopg and friends.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Bring in the backend source, then install it editable so `docker-compose`
# volume-mounting ./backend over /app/backend for hot reload keeps working
# without reinstalling (the editable install just points back at the tree).
COPY backend /app/backend
WORKDIR /app/backend
RUN pip install --upgrade pip && pip install -e ".[dev]"

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
