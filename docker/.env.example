# ---------------------------------------------------------------------------
# PharmaLink AI — environment configuration template.
# Copy to `docker/.env` for local docker-compose use, and never commit the
# real `.env` (see .gitignore). Every variable here is read by
# backend/app/core/config.py::Settings.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------
APP_NAME=PharmaLink AI
ENV=development           # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database (TimescaleDB / PostgreSQL) --------------------------------
POSTGRES_USER=medcycle
POSTGRES_PASSWORD=medcycle_dev_password
POSTGRES_DB=medcycle
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full async SQLAlchemy URL, built from the parts above by default; override
# to point at a different database (e.g. CI, managed cloud Postgres).
DATABASE_URL=postgresql+asyncpg://medcycle:medcycle_dev_password@db:5432/medcycle

# --- Redis (Celery broker/result backend + caching) ---------------------
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ----------------------------------------------------------
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_dev_only_insecure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins for the Next.js frontend.
CORS_ORIGINS=http://localhost:3000

# --- LLM explanation layer (Groq — OpenAI-compatible endpoint) ---------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Frontend (Milestone D) -------------------------------------------------
# Browser-reachable backend URL — the browser calls this directly (TanStack
# Query runs client-side), not the Docker-internal `backend` hostname.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# No map API key needed: the hospital map uses MapLibre GL + free vector
# tiles, not Mapbox GL JS, specifically to avoid a second external key
# dependency (see docs/architecture.md).
