# ---------------------------------------------------------------------------
# MedCycle AI — environment configuration template.
# Copy to `docker/.env` for local docker-compose use, and never commit the
# real `.env` (see .gitignore). Every variable here is read by
# backend/app/core/config.py::Settings.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------
APP_NAME=MedCycle AI
ENV=development           # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database (TimescaleDB / PostgreSQL) --------------------------------
POSTGRES_USER=medcycle
POSTGRES_PASSWORD=medcycle_dev_password
POSTGRES_DB=medcycle
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full async SQLAlchemy URL, built from the parts above by default; override
# to point at a different database (e.g. CI, managed cloud Postgres).
DATABASE_URL=postgresql+asyncpg://medcycle:medcycle_dev_password@db:5432/medcycle

# --- Redis (Celery broker/result backend + caching) ---------------------
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ----------------------------------------------------------
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_dev_only_insecure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins for the Next.js frontend.
CORS_ORIGINS=http://localhost:3000

# --- LLM explanation layer (wired in Milestone C — safe to leave blank now) ---
LLM_PROVIDER=anthropic     # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Mapbox (frontend, Milestone D) ---------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=
