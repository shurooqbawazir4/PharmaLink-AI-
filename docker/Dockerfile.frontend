# MedCycle AI frontend — dev-mode container.
#
# Mirrors docker/Dockerfile.backend's dev-container shape: dependencies are
# baked into the image at build time, source is bind-mounted at runtime
# (see docker-compose.yml) for hot reload, so a source change never needs a
# rebuild. A production multi-stage build (standalone Next.js output +
# nginx reverse proxy) is Milestone E's job — this image is deliberately
# dev-only, matching the "Docker only, no local Node" constraint that makes
# a working dev server the actual deliverable for Milestone D.
FROM node:22-alpine

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

COPY frontend .

EXPOSE 3000

CMD ["npm", "run", "dev"]
