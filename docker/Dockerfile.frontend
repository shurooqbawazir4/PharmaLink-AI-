# PharmaLink AI frontend — multi-stage: `dev` (Milestone D, unchanged) and
# `prod` (Milestone E: Next.js standalone output, no bind mount, no
# node_modules in the final image). docker-compose.yml uses `dev` by
# default; docker-compose.prod.yml overrides the frontend service to build
# the `prod` target and fronts it with nginx (see docker/nginx/nginx.conf).

FROM node:22-alpine AS base
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json* ./

# --- dev: deps baked into the image, source bind-mounted at runtime for
# hot reload (see docker-compose.yml's volumes) — a source change never
# needs a rebuild.
FROM base AS dev
RUN npm install
COPY frontend .
EXPOSE 3000
CMD ["npm", "run", "dev"]

# --- prod: full source copied in, built once, then only the standalone
# output ships — no bind mount, no dev dependencies, no source in the
# final image. NEXT_PUBLIC_* vars are inlined into the client bundle at
# *build* time (not read at container start), so it's an ARG here, not a
# runtime environment/compose var — docker-compose.prod.yml passes
# `/api/v1` (relative to nginx's own origin, host-agnostic).
FROM base AS build
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm install
COPY frontend .
RUN npm run build

FROM node:22-alpine AS prod
WORKDIR /app/frontend
ENV NODE_ENV=production
COPY --from=build /app/frontend/public ./public
COPY --from=build /app/frontend/.next/standalone ./
COPY --from=build /app/frontend/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
